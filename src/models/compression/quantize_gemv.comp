#version 450

layout(local_size_x = 128) in;

// Binding 0: Source weights — read-only input
layout(std430, set = 0, binding = 0) readonly buffer SourceWeights {
    float weights[];
};

// Binding 1: Work pool — atomic claim/done bits
layout(std430, set = 0, binding = 1) buffer GpuWorkPool {
    uint work[];
};

// Binding 2: Global counters — atomic allocation offsets per prefix
layout(std430, set = 0, binding = 2) buffer GlobalCounters {
    uint counters[];
};

// Binding 3: Bucket data — packed u8 tail output
layout(std430, set = 0, binding = 3) buffer BucketData {
    uint bucket[];
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
    uint bucket_max_capacity; // max u32 slots per bucket (padded)
} params;

#define COUNTER_BASE 0
#define DATA_BASE 100

// Shared memory allocations for intra-group staging
shared uint s_local_counters[100];
shared uint s_group_global_offsets[100];

void main() {
    uint local_idx = gl_LocalInvocationID.x;
    uint idx = gl_GlobalInvocationID.x;

    // 1. Initialize local workgroup counters to 0
    if (local_idx < 100) {
        s_local_counters[local_idx] = 0;
        s_group_global_offsets[local_idx] = 0u;
    }
    barrier();

    uint prefix = 0;
    uint tail = 0;
    bool valid_element = (idx < params.total_elements);

    if (valid_element) {
        float weight = abs(weights[idx]);

        // Uniformly extract the first two fractional digits as the prefix
        // e.g., 0.39302838 * 100.0 = 39.302838 -> prefix = 39
        float scaled_weight = weight * 100.0;
        prefix = uint(floor(scaled_weight)) % 100u;

        // Tail tracks the remaining digits scaled to match u8 resolution
        float tail_float = (scaled_weight - floor(scaled_weight)) * 1000.0;
        tail = min(uint(tail_float + 0.5), 255u);
    }

    // 2. Count elements locally within the fast L1 Cache Workgroup block first
    uint local_pos = 0;
    if (valid_element) {
        local_pos = atomicAdd(s_local_counters[prefix], 1u);
    }
    barrier();

    // 3. Complete allocation step across ALL threads to avoid uninitialized states
    if (local_idx < 100) {
        uint total_group_count_for_prefix = s_local_counters[local_idx];
        if (total_group_count_for_prefix > 0) {
            s_group_global_offsets[local_idx] = atomicAdd(
                counters[COUNTER_BASE + local_idx],
                total_group_count_for_prefix
            );
        }
    }
    barrier(); // CRITICAL: Every thread must wait here before Step 4

    // 4. Coalesce and write straight to global VRAM with clean hardware assignment
    if (valid_element) {
        uint global_pos = s_group_global_offsets[prefix] + local_pos;
        uint bucket_base = DATA_BASE + (prefix * params.bucket_max_capacity);
        uint u32_index = bucket_base + (global_pos / 4);
        uint shift = (global_pos % 4) * 8;

        // Atomic OR safely packs the u8 tail bytes into the global u32 word
        atomicOr(bucket[u32_index], tail << shift);

        // Signal completion in work pool (set DONE_BIT = bit 30)
        if (local_pos == 0) {
            atomicOr(work[idx], 1u << 30);
        }
    }
}
