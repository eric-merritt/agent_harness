#version 450
//
// Trellis bit quantizer — Vulkan 1.3 compute (no lookups, no CUDA, vendor-agnostic).
//
// ── ONE WARP PER TILE ────────────────────────────────────────────────────────────
// local_size_x = 32, local_size_y = 4 : one workgroup = 128 threads = 4 warps = 4 tiles.
// Warp w (w = flat_lane / 32) owns tile w entirely: its own staged weights, its own
// Viterbi cost row, its own backpointer arena slice. A warp does its whole DP + traceback
// alone — no cross-warp shuffles for the DP at all. The only shared state a warp touches
// is its own per-tile rows in shared memory and its own bytes in the sparse-buffer arena.
//
// Why one warp per tile: the trellis DP is inherently sequential down the ring (each step
// reads the previous cost row), so it can't be split across warps without a barrier every
// step — which is exactly what the old 4-warps-per-tile version did, and it stalled. A
// single warp keeps its whole tile in registers + its own shared rows and marches down the
// ring with no inter-warp sync. Four independent tiles per workgroup give the SM four
// warps to hide each other's latency.
//
// Per-tile state (all in shared, indexed by warp id so the 4 tiles never collide):
//     wt[1024]    : the staged 32×32 tile            4 KB/tile
//     cost[256]   : current Viterbi cost row          —
//     bcost[256]  : scratch next-row during a step    —
//   = 6 KB/tile × 4 tiles = 24 KB/workgroup, well under the 48 KB/workgroup cap.
//
// The backpointer window (WIN×NSTATE = 8 KB/tile) is NOT in shared: it's written once per
// step and read exactly once at traceback, so on-chip it's pure dead weight. It lives in
// the sparse-buffer arena (binding 2), one slice per tile at
//     gl_WorkGroupID.x * (4 * WIN*NSTATE) + warp_id * (WIN*NSTATE).
//
// ── ZERO LOOKUPS ────────────────────────────────────────────────────────────────
// No codebook table, no transition LUT, ever. Every decoded symbol is computed from its
// index by the mul1 lattice formula (one mul + one and + one add → fp16 bits):
//     decode(i) = half_bits( ((i * 0x83DCD12Du) & 0xFFFFu) + 0x6400 )
// The DP transition output for state s is decode(low-K-bits(s)); the cost compare is a
// plain integer `<` on fixed-point (shift-scaled) squared error.
//
// ── BINDINGS (tile-ring pipeline, batch double-buffered by the host) ────────────
//   binding 0 : INPUT RING — SLOTS TileSlots back-to-back, one per in-flight tile:
//               [1024×f32 tile][u32 K][f32 scale][u32 flag]  (4108 B each)
//               CPU writes data/K/scale then flag = seq; we read it when flag == seq.
//   binding 1 : OUTPUT RING — SLOTS OutSlots back-to-back:
//               [packed words][f32 scale][u32 done_flag]
//               We write the packed stream + scale, then done_flag = seq (release).
//   binding 2 : BACKPOINTER ARENA — one WIN×NSTATE byte block PER TILE (4 per workgroup),
//               laid out contiguously. The host commits every page before dispatch; it's
//               small enough to stay fully GPU-resident the whole run, so no streaming.
//
// The host dispatches `SLOTS/4` workgroups per batch (4 tiles each); workgroup g, warp w
// handles global tile  g*4 + w. Batch N+1 is prepped by the CPU while this batch runs.

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x = 32, local_size_y = 4) in;

// One input tile slot: the 32×32 f32 weights + rate + scale + handshake flag.
struct TileSlot {
    float data[1024];
    uint k;
    float scale;
    uint flag;
};

// One output slot: packed bitstream words (max K=8 → 1024 words) + fp32 scale + done flag.
struct OutSlot {
    uint wdata[1024];
    float scale;
    uint done_flag;
};

layout(std430, binding = 0) buffer InRing {
    TileSlot slots[];
} inring;

layout(std430, binding = 1) buffer OutRing {
    OutSlot oslots[];
} outring;

// Backpointer arena: WIN*NSTATE bytes per TILE (4 tiles per workgroup), indexed by the
// global tile id. Lives in the sparse-buffer arena (binding 2), not shared memory.
layout(std430, binding = 2) buffer BpArena {
    int8_t bp[];
} bparena;

const uint TILE = 32u;
const uint RING = TILE * TILE;   // 1024 elements per tile ring
const uint NSTATE = 256u;        // 8-bit trellis states (QTIP/TCQ-class)
const uint WIN = 32u;            // sliding window: 32 ring steps per on-chip traceback
const uint TILES_PER_WG = 4u;    // one warp per tile, 4 warps in this workgroup

// ── Shared memory — one set of rows PER TILE (per warp), so the 4 tiles are isolated. ─
// wt:      the staged tile, one row of RING floats per tile.
shared float wt[TILES_PER_WG * RING];
// cost / bcost: the Viterbi cost row + scratch, one NSTATE row per tile.
shared uint  cost[TILES_PER_WG * NSTATE];
shared uint  bcost[TILES_PER_WG * NSTATE];
// win_words: this tile's packed bitstream, accumulated window-by-window so the final
// coalesced write-out below can read it all at once. Worst case K=8 → RING words/tile.
// That's 4 KB/tile × 4 = 16 KB — pushes total shared to 24+16 = 40 KB, still under 48.
shared uint  win_words[TILES_PER_WG * RING];

// ── mul1 lattice decode — pure arithmetic, no table. ───────────────────────────
// i is the K low bits of a state; returns the fp16 codebook value as an f32.
float mul1_decode(uint i) {
    uint hw = (i * 0x83DCD12Du) & 0xFFFFu;   // magic-constant lattice step
    hw += 0x6400u;                            // bias into the positive half range
    return unpackHalf2x16(hw).x;
}

// Fixed-point squared error: (a - b)^2 scaled by 2^SHIFT, returned as uint. The shift
// keeps the product in integer land so the min-select is a plain `<` — no float compare.
uint fp_sq_err(float a, float b) {
    float d = a - b;
    // Round |d| to an integer of ~2^-10 resolution, clamp, square in 64-bit-free u32 space.
    uint m = uint(clamp(abs(d) * 1024.0, 0.0, 65535.0));
    return (m * m) >> 4;   // /16 to stay well under u32 overflow for |d|<=~8
}

// One Viterbi step over the trellis graph, done by a SINGLE WARP for its own tile.
// Each of the warp's 32 lanes covers two target states (lane l → targets 2l, 2l+1), so
// all 256 states are covered with no idle lanes and no cross-warp traffic. The cost row
// lives in this warp's shared slice; the backpointer row goes to the arena. `mask` is
// this tile's (1<<K)-1, `x` the current ring element, `step_in_win` the step within the
// window (for the arena offset), and `bp_base`/`c_base` point at this tile's slices.
void viterbi_step(float x, uint step_in_win, uint mask, uint lane,
                  uint bp_base, uint c_base) {
    uint t0 = lane * 2u;
    uint t1 = lane * 2u + 1u;

    // Arena row for this step: WIN*NSTATE bytes per tile, offset by the tile's slice.
    uint bp_off = bp_base + step_in_win * NSTATE;

    // Target t0: min over its two legal predecessors.
    {
        uint p0 = ((t0 << 1u) | 0u) & 0xFFu;
        uint p1 = ((t0 << 1u) | 1u) & 0xFFu;
        float s0 = mul1_decode(p0 & mask);
        float s1 = mul1_decode(p1 & mask);
        uint c0 = cost[c_base + p0] + fp_sq_err(x, s0);
        uint c1 = cost[c_base + p1] + fp_sq_err(x, s1);
        if (c1 < c0) { c0 = c1; p0 = p1; }
        bcost[c_base + t0] = c0; bparena.bp[bp_off + t0] = int8_t(p0);
    }
    // Target t1: same, two legal predecessors.
    {
        uint p0 = ((t1 << 1u) | 0u) & 0xFFu;
        uint p1 = ((t1 << 1u) | 1u) & 0xFFu;
        float s0 = mul1_decode(p0 & mask);
        float s1 = mul1_decode(p1 & mask);
        uint c0 = cost[c_base + p0] + fp_sq_err(x, s0);
        uint c1 = cost[c_base + p1] + fp_sq_err(x, s1);
        if (c1 < c0) { c0 = c1; p0 = p1; }
        bcost[c_base + t1] = c0; bparena.bp[bp_off + t1] = int8_t(p0);   // winner is in p0 after the swap above
    }
}

void main() {
    // This warp's identity within the workgroup: warp w owns tile w.
    uint warp_id = gl_LocalInvocationIndex / 32u;   // 0..3 (4 warps)
    uint lane    = gl_LocalInvocationIndex % 32u;   // 0..31

    // Global tile id: workgroup g holds tiles [g*4, g*4+3]; this warp takes tile w.
    uint tile_id = gl_WorkGroupID.x * TILES_PER_WG + warp_id;

    TileSlot s = inring.slots[tile_id];

    uint K = s.k;
    uint mask = (K > 0u) ? ((1u << K) - 1u) : 0u;

    // This tile's slice offsets into the shared rows and the arena.
    uint wt_base  = warp_id * RING;
    uint c_base   = warp_id * NSTATE;
    uint bp_base  = tile_id * (WIN * NSTATE);

    // DEBUG: phase progress marker (host reads this to see where we're stuck).
    if (lane == 0u) { outring.oslots[tile_id].wdata[1] = 1u; }

    // ── Stage this tile's 32×32 weights into its shared row (coalesced, warp-only). ──
    for (uint i = lane; i < RING; i += 32u) {
        wt[wt_base + i] = s.data[i];
    }
    // Synchronize only THIS warp — the other 3 warps are working on their own tiles and
    // must not be stalled by this one. (A full barrier() here would serialize all 4.)
    subgroupBarrier();

    if (lane == 0u) { outring.oslots[tile_id].wdata[1] = 2u; }

    // ── Per-tile scale: rms(tile), reduced across this warp only. ────────────────
    float acc = 0.0;
    for (uint i = lane; i < RING; i += 32u) { acc += wt[wt_base + i] * wt[wt_base + i]; }
    // Intra-warp fold via shuffle (no reduce builtin in the basic subgroup ext).
    float r = acc;
    for (uint m = 16u; m > 0u; m >>= 1) { r += subgroupShuffleXor(r, m); }
    float rms = sqrt(r / float(RING));

    if (lane == 0u) { outring.oslots[tile_id].wdata[1] = 3u; }

    // ── Seed the cost row: state 0 free, others pay 1 (gives the ring a start). ────
    if (lane == 0u) {
        for (uint s_ = 0u; s_ < NSTATE; ++s_) {
            cost[c_base + s_] = (s_ == 0u) ? 0u : 1u;
        }
    }
    subgroupBarrier();

    if (lane == 0u) { outring.oslots[tile_id].wdata[1] = 4u; }

    // DEBUG: write a marker before the outer loop to see if we reach it
    if (gl_LocalInvocationIndex == 0u) { outring.oslots[0].wdata[2] = 0xDEAD; }

    // ── Sliding-window Viterbi over the 1024-ring, 32 steps per window. ───────────
    for (uint w = 0u; w < RING / WIN; ++w) {
        // Forward pass over this window's 32 steps, recording bp[] to the arena.
        for (uint st = 0u; st < WIN; ++st) {
            uint pos = w * WIN + st;              // ring position
            float x = wt[wt_base + pos];

            // Execute the Viterbi step for this tile's row
            viterbi_step(x, st, mask, lane, bp_base, c_base);

            // Critical: Force all 4 warps to complete writes to bcost[] and bp arena
            // before any single thread attempts to execute the swap phase.
            barrier();

            // Parallel Swap: All 128 threads cooperate to execute the row swap uniformly.
            // With 128 threads active across the workgroup, each individual thread handles
            // exactly 2 elements to cover the 256 trellis states (128 * 2 = 256).
            uint idx0 = gl_LocalInvocationIndex;
            uint idx1 = gl_LocalInvocationIndex + 128u;

            uint tmp0 = cost[c_base + idx0];
            cost[c_base + idx0] = bcost[c_base + idx0];
            bcost[c_base + idx0] = tmp0;

            uint tmp1 = cost[c_base + idx1];
            cost[c_base + idx1] = bcost[c_base + idx1];
            bcost[c_base + idx1] = tmp1;

            // Sync the entire workgroup again so that the swapped cost values are
            // globally visible before any warp initiates the next loop step.
            barrier();
        }

        // ── Traceback: reconstruct this window's 32 states, pack into words. ──────
        // The whole warp does it (lane l = step l). Backpointers are in the arena (we
        // just wrote them → L2 hit), read back here.
        {
            // 1. Parallel 256-state min-cost reduction across the warp.
            uint min_c = cost[c_base + lane];
            uint min_idx = lane;
            for (uint stride = 32u; stride < NSTATE; stride += 32u) {
                uint c = cost[c_base + lane + stride];
                if (c < min_c) { min_c = c; min_idx = lane + stride; }
            }
            for (uint offset = 16u; offset > 0u; offset >>= 1) {
                uint remote_c = subgroupShuffleXor(min_c, offset);
                uint remote_idx = subgroupShuffleXor(min_idx, offset);
                if (remote_c < min_c) { min_c = remote_c; min_idx = remote_idx; }
            }
            uint end_state = subgroupShuffle(min_idx, 0u);

            // 2. Walk back WIN-1 steps; lane l captures the state at step l. The path
            //    pointer must stay UNIFORM across the warp: read the backpointer for the
            //    single state the whole warp is tracking, then broadcast it so all 32
            //    lanes walk the same global path backward in lockstep.
            uint my_symbol = 0u;
            for (int step = int(WIN) - 1; step >= 0; --step) {
                if (lane == uint(step)) {
                    my_symbol = end_state & mask;
                }
                uint next_state = uint(bparena.bp[bp_base + step * NSTATE + end_state]) & 0xFFu;
                end_state = subgroupShuffle(next_state, 31u);
            }

            // 3. Pack: symbol l's K bits go to global bit position (l*K .. l*K+K-1). A
            //    window holds 32 symbols = up to 256 bits at K=8 → several words. Reduce
            //    PER OUTPUT WORD (a blind whole-warp OR would crush word-boundary symbols
            //    into one register). For each word j, mask out only the bits that land in
            //    it and let lane j commit. In-register throughout — no shared RMW.
            uint n_win_words = (WIN * K + 31u) / 32u;   // ≤ 4 at K≤8

            uint my_bits = 0u;
            for (uint b = 0u; b < K; ++b) {
                if (((my_symbol >> b) & 1u) != 0u) {
                    uint bit_pos = lane * K + b;
                    my_bits |= (1u << (bit_pos & 31u));
                }
            }

            // Commit this window's words into the tile's packed row; the final write-out
            // reads them all back once every window is done.
            [[unroll]]
            for (uint j = 0u; j < 8u; ++j) {
                if (j >= n_win_words) break;

                uint symbol_start_word = (lane * K) >> 5u;
                uint symbol_end_word   = ((lane * K) + K - 1u) >> 5u;

                uint word_contribution = 0u;
                if (symbol_start_word == j || symbol_end_word == j) {
                    uint bit_mask = 0xFFFFFFFFu;
                    if (symbol_start_word != j) bit_mask = ~((1u << ((lane * K) & 31u)) - 1u);
                    if (symbol_end_word != j)   bit_mask = (1u << (((lane * K) + K) & 31u)) - 1u;

                    word_contribution = my_bits & bit_mask;
                }

                for (uint offset = 16u; offset > 0u; offset >>= 1) {
                    word_contribution |= subgroupShuffleXor(word_contribution, offset);
                }

                if (lane == j) {
                    // Global packed-word index for this window's word j.
                    uint gw = w * n_win_words + j;
                    win_words[warp_id * ((RING / WIN) * 4u) + gw] = word_contribution;
                }
            }
        }
        subgroupBarrier();
    }

    if (lane == 0u) { outring.oslots[tile_id].wdata[1] = 5u; }

    // ── Coalesced write-out of this tile's packed stream to its output slot. ───────
    uint total_packed_words = (RING * K + 31u) / 32u;   // ≤ 1024 at K≤8
    for (uint i = lane; i < total_packed_words; i += 32u) {
        outring.oslots[tile_id].wdata[i] = win_words[warp_id * ((RING / WIN) * 4u) + i];
    }
    if (lane == 0u) {
        outring.oslots[tile_id].scale = rms;
        memoryBarrierBuffer();
        outring.oslots[tile_id].done_flag = s.flag + 1u;   // handshake: CPU set flag=seq, we answer seq+1
    }
}
