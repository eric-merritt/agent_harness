#version 450
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

layout(local_size_x = 128) in;

// Use layout qualifiers that match a linear 1D layout over the sparse buffer shell
layout(std430, set = 0, binding = 0) readonly buffer SourceWeights {
    float weights[];
};

// Destination blocks allocated directly inside the Virtual Arena memory array
layout(std430, set = 0, binding = 1) writeonly buffer SignOutput {
    uint sign_pack_u32[]; // 1 bit per element, 32 elements per u32
};

layout(std430, set = 0, binding = 2) writeonly buffer QuantizedOutput {
    uint packed_data[]; // prefix+tail pairs, one per element
};

layout(push_constant) uniform PushConstants {
    uint total_elements;
} params;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= params.total_elements) return;

    // Load original f32
    float weight = weights[idx];
    uint raw_bits = floatBitsToUint(weight);
    bool is_negative = (raw_bits >> 31) != 0;
    weight = abs(weight);

    // 1. Packed Sign Processing (Warp-Coalesced)
    uvec4 ballot = subgroupBallot(is_negative);
    if (gl_SubgroupInvocationID == 0) {
        sign_pack_u32[idx / 32] = ballot.x;
    }

    // 2. Quantization logic
    if (weight >= 10.0) {
        float integer_part;
        weight = modf(weight * 0.01, integer_part) * 100.0;
    }
    uint prefix = uint(weight);
    float tail_float = (weight - float(prefix)) * 1000.0;

    uint tail_bits = floatBitsToUint(tail_float);
    uint round_bit = 1 << 2;
    uint lsb_bit   = 1 << 3;
    if ((tail_bits & round_bit) != 0) {
        if ((tail_bits & (round_bit - 1)) != 0 || (tail_bits & lsb_bit) != 0) {
            tail_bits += lsb_bit;
        }
    }
    tail_bits &= 0xFFFFFFF8;
    uint tail_int = uint(round(uintBitsToFloat(tail_bits)));

    // Pack prefix and tail into a single u16 value
    uint packaged_value = ((tail_int & 0xFF) << 8) | (prefix & 0xFF);

    // Warp-coalesced pair packing: pull sibling value from register, no memory race
    uint sibling_value = subgroupShuffle(packaged_value, (gl_SubgroupInvocationID | 1));
    if ((gl_SubgroupInvocationID % 2) == 0) {
        uint pair_packed = (sibling_value << 16) | (packaged_value & 0xFFFF);
        packed_data[idx / 2] = pair_packed;
    }
}
